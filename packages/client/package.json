{
  "name": "@tauri-custom-installer/client",
  "version": "0.2.0",
  "description": "Framework-agnostic Client SDK and adapters (React, Svelte, Vue, Solid, Vanilla) for Tauri v2 custom installers",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js",
      "require": "./dist/react/index.js",
      "default": "./dist/react/index.js"
    },
    "./svelte": {
      "types": "./dist/svelte/index.d.ts",
      "import": "./dist/svelte/index.js",
      "require": "./dist/svelte/index.js",
      "default": "./dist/svelte/index.js"
    },
    "./vue": {
      "types": "./dist/vue/index.d.ts",
      "import": "./dist/vue/index.js",
      "require": "./dist/vue/index.js",
      "default": "./dist/vue/index.js"
    },
    "./solid": {
      "types": "./dist/solid/index.d.ts",
      "import": "./dist/solid/index.js",
      "require": "./dist/solid/index.js",
      "default": "./dist/solid/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "bun test"
  },
  "peerDependencies": {
    "@tauri-apps/api": "^2.0.0",
    "react": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "@tauri-apps/api": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@types/react": "^19.0.8",
    "react": "^19.0.0",
    "typescript": "^5.7.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/tauri-custom-installer/tauri-custom-installer.git"
  },
  "keywords": [
    "tauri",
    "installer",
    "windows",
    "nsis",
    "react",
    "svelte",
    "vue",
    "solid"
  ],
  "author": "kmaksuut",
  "license": "MIT"
}
