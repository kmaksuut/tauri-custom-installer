{
  "identifier": "default",
  "description": "Default capabilities for the custom installer runtime window",
  "windows": ["main"],
  "remote": {
    "urls": ["http://tci.localhost/**", "tci://localhost/**"]
  },
  "permissions": [
    "core:default",
    "core:window:allow-minimize",
    "core:window:allow-close",
    "core:window:allow-start-dragging"
  ]
}
