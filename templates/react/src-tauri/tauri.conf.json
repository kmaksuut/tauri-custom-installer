{
  "$schema": "https://schema.tauri.app/v2/config",
  "productName": "Application Setup",
  "version": "1.0.0",
  "identifier": "com.tauri.custominstaller.setup",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1421",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Application Setup",
        "width": 680,
        "height": 450,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "center": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self' tci: http://tci.localhost ipc: http://ipc.localhost; img-src 'self' data: blob: tci: http://tci.localhost; style-src 'self' 'unsafe-inline' tci: http://tci.localhost; script-src 'self' 'unsafe-inline' tci: http://tci.localhost"
    }
  },
  "bundle": {
    "active": false,
    "targets": [],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
